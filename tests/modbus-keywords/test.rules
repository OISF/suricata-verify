alert modbus any any -> any any (msg:"modbus.unit_id"; modbus.unit_id:10; sid:1;)
alert modbus any any -> any any (msg:"modbus.transaction_id"; modbus.transaction_id:1; sid:2;)
alert modbus any any -> any any (msg:"modbus.protocol_id"; modbus.protocol_id:0; sid:3;)
alert modbus any any -> any any (msg:"modbus.function"; modbus.function:8; sid:4;)
alert modbus any any -> any any (msg:"modbus.subfunction"; modbus.subfunction:4; sid:5;)
alert modbus any any -> any any (msg:"modbus.exception_code"; modbus.exception_code:11; sid:6;)
alert modbus any any -> any any (msg:"modbus.read.address"; modbus.read.address:2; sid:7;)
alert modbus any any -> any any (msg:"modbus.read.quantity"; modbus.read.quantity:2; sid:8;)
alert modbus any any -> any any (msg:"modbus.write.address"; modbus.write.address:5; sid:9;)
alert modbus any any -> any any (msg:"modbus.write.value"; modbus.write.value:11; sid:10;)
alert modbus any any -> any any (msg:"modbus.unit_id negation"; modbus.unit_id:!10; sid:11;)
alert modbus any any -> any any (msg:"modbus.read.quantity range"; modbus.read.quantity:0-3; sid:12;)
alert modbus any any -> any any (msg:"modbus.unit_id no match"; modbus.unit_id:11; sid:13;)
alert modbus any any -> any any (msg:"exception to client"; flow:to_client; modbus.exception_code:11; sid:14;)
alert modbus any any -> any any (msg:"exception to server"; flow:to_server; modbus.exception_code:11; sid:15;)
