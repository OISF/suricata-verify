# pcap has one HTTP request with URI /Zm9vYmFy!!YmF6. After the "/", the
# input is "foobar" and "baz" in base64 with "!!" between them.

# rfc4648 stops at "!!" and keeps "foobar"; that is a successful decode
alert http any any -> any any (msg:"rfc4648 keeps the decoded part"; flow:established,to_server; \
    http.uri; from_base64: offset 1, mode rfc4648; content:"foobar"; startswith; endswith; sid:1;)
alert http any any -> any any (msg:"rfc4648 must_error"; flow:established,to_server; \
    http.uri; from_base64: offset 1, mode rfc4648; transform_result: must_error; sid:2;)
alert http any any -> any any (msg:"rfc4648 must_succeed"; flow:established,to_server; \
    http.uri; from_base64: offset 1, mode rfc4648; transform_result: must_succeed; \
    content:"foobar"; sid:3;)

# rfc2045 skips "!!" and decodes all of it
alert http any any -> any any (msg:"rfc2045 skips the invalid bytes"; flow:established,to_server; \
    http.uri; from_base64: offset 1, mode rfc2045; content:"foobarbaz"; \
    startswith; endswith; sid:4;)
alert http any any -> any any (msg:"rfc2045 must_error"; flow:established,to_server; \
    http.uri; from_base64: offset 1, mode rfc2045; transform_result: must_error; sid:5;)

# strict rejects the whole input
alert http any any -> any any (msg:"strict must_error"; flow:established,to_server; \
    http.uri; from_base64: offset 1, mode strict; transform_result: must_error; sid:6;)
