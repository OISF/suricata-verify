# Flow 1 posts 60000 bytes of valid base64 with no line breaks. The body is
# inspected in windows, and a strict decode of a window that does not start
# or end on a 4-byte boundary fails. Flow 2 posts a short body that is not
# base64 and is inspected in one piece.

alert http any any -> any any (msg:"request body must_error"; flow:established,to_server; \
    http.request_body; from_base64: mode strict; transform_result: must_error; sid:1;)
alert http any any -> any any (msg:"file.data must_error"; flow:established,to_server; \
    file.data; from_base64: mode strict; transform_result: must_error; sid:2;)
alert http any any -> any any (msg:"request body error_or"; flow:established,to_server; \
    http.request_body; from_base64: mode strict; transform_result: error_or; \
    content:"no-such-content"; sid:3;)

# error_or must not try the keywords after it on a window whose decode
# failed: that window still holds the base64 text, which a decoded window
# never contains
alert http any any -> any any (msg:"request body error_or on base64 text"; \
    flow:established,to_server; http.request_body; from_base64: mode strict; \
    transform_result: error_or; content:"UvImZaYM"; sid:4;)
