# pcap has one HTTP request with an empty Referer header value.

alert http any any -> any any (msg:"empty referer"; flow:established,to_server; \
    http.referer; bsize:0; sid:1;)

# from_base64 leaves an empty buffer as it is and does not flag an error
alert http any any -> any any (msg:"empty referer after from_base64"; flow:established,to_server; \
    http.referer; from_base64; bsize:0; sid:2;)
alert http any any -> any any (msg:"empty referer must_error"; flow:established,to_server; \
    http.referer; from_base64; transform_result: must_error; sid:3;)
alert http any any -> any any (msg:"empty referer error_or"; flow:established,to_server; \
    http.referer; from_base64; transform_result: error_or; content:"x"; sid:4;)
