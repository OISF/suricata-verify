# pcap has one HTTP GET with no Referer header and no request body, so both
# http.referer and http.request_body are absent. error_or matches an absent
# buffer, as absent: or_else does (sids 2 and 6); must_error and must_succeed
# never do (sids 1, 3 and 5). The absent controls (sids 4 and 7) show the
# buffers are absent.

alert http any any -> any any (msg:"absent referer must_error"; flow:to_server; \
    http.referer; from_base64; transform_result: must_error; sid:1;)
alert http any any -> any any (msg:"absent referer error_or"; flow:to_server; \
    http.referer; from_base64; transform_result: error_or; content:"x"; sid:2;)
alert http any any -> any any (msg:"absent referer must_succeed"; flow:to_server; \
    http.referer; from_base64; transform_result: must_succeed; content:"x"; sid:3;)
alert http any any -> any any (msg:"absent referer control"; flow:to_server; \
    http.referer; absent; sid:4;)

alert http any any -> any any (msg:"absent request body must_error"; flow:to_server; \
    http.request_body; from_base64; transform_result: must_error; sid:5;)
alert http any any -> any any (msg:"absent request body error_or"; flow:to_server; \
    http.request_body; from_base64; transform_result: error_or; content:"x"; sid:6;)
alert http any any -> any any (msg:"absent request body control"; flow:to_server; \
    http.request_body; absent; sid:7;)
