# tls.version matches the negotiated (hello) version
alert tls any any -> any any (msg:"tls.version negotiated 1.2"; tls.version:1.2; sid:1;)
# ssl_version matches the record layer version (0x0301 here)
alert tls any any -> any any (msg:"ssl_version record 1.0"; ssl_version:tls1.0; sid:2;)
alert tls any any -> any any (msg:"tls.version 1.3 absent"; tls.version:1.3; sid:3;)
alert tls any any -> any any (msg:"ssl_version record 1.2 absent"; ssl_version:tls1.2; sid:4;)
