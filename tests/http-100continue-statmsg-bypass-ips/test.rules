# Rules for the 100-continue stat_msg bypass test.
#
# 1101: the "final 200" rule on flow A (baseline). Fires normally.
# 1102: the "final 200" rule on flow B. Expected to fire once; on a
#       pre-fix build it does NOT fire (the bypass - the final
#       response's reason phrase is never inspected).
# 1103: the "100 line" rule on flow B. Expected to fire once; on a
#       pre-fix build it double-alerts (HEADERS final run + LINE
#       non-terminal re-run after the rewind, against the stale
#       buffer).
alert tcp 10.0.0.2 any -> 10.0.0.1 10000 (msg:"100continue-stat_msg 200 stat_msg (baseline)"; sid:1101; rev:1; http.stat_msg; content:"OK";)
alert tcp 10.0.0.2 any -> 10.0.0.3 10001 (msg:"100continue-stat_msg 200 stat_msg"; sid:1102; rev:1; http.stat_msg; content:"OK";)
alert tcp 10.0.0.2 any -> 10.0.0.3 10001 (msg:"100continue-stat_msg 100 stat_msg"; sid:1103; rev:1; http.stat_msg; content:"Continue";)
