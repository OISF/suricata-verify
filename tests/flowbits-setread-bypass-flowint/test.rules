# sid:1 sets flowint cnt, sid:2 reads it. Both are flowbits SET_READ, on
# unrelated bits, so there is no flowbit dependency between them.
alert tcp any any -> any any (flowbits:isset,a1; flowbits:set,a2; flowint:cnt,=,1; sid:1;)
alert tcp any any -> any any (flowbits:isset,b1; flowbits:set,b2; flowint:cnt,==,1; sid:2;)
# Control: the same flowint dependency, listed in the same order, without
# flowbits. SCSigOrderByFlowintCompare keeps the setter ahead of the reader.
alert tcp any any -> any any (flowint:cnt,=,1; sid:3;)
alert tcp any any -> any any (flowint:cnt,==,1; sid:4;)
