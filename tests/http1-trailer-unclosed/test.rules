# trailer block never terminated, closed by FIN: trailer buffers see what was parsed
alert http any any -> any any (msg:"trl raw"; flow:to_server; http.trailer.raw; content:"X-TrailerField|3a 20|u1"; sid:10; rev:1;)
alert http any any -> any any (msg:"trl field"; flow:to_server; http.trailer; content:"X-TF2|3a 20|u2"; sid:11; rev:1;)
# control: same traffic with a terminated trailer block
alert http any any -> any any (msg:"ctl trl"; flow:to_server; http.trailer; content:"X-TF2|3a 20|tv2"; sid:20; rev:1;)
alert http any any -> any any (msg:"ctl hdr raw"; flow:to_server; http.header.raw; content:"X-Marker|3a 20|yes"; sid:21; rev:1;)
