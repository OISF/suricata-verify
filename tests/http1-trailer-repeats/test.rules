# one trailer name repeated 70 times: merged up to the cap, then dropped
alert http any any -> any any (msg:"v1 kept"; flow:to_server; http.trailer; content:"|3a 20|v1|2c 20|v2"; sid:1; rev:1;)
alert http any any -> any any (msg:"v66 kept"; flow:to_server; http.trailer; content:"|2c 20|v66|0d 0a|"; sid:2; rev:1;)
alert http any any -> any any (msg:"v67 dropped"; flow:to_server; http.trailer; content:"|2c 20|v67"; sid:3; rev:1;)
alert http any any -> any any (msg:"raw keeps v70"; flow:to_server; http.trailer.raw; content:"A|3a 20|v70|0d 0a|"; sid:4; rev:1;)
alert http any any -> any any (msg:"header control"; flow:to_server; http.header; content:"a.example"; sid:10; rev:1;)
