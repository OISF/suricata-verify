# Per-buffer validation of the remaining request-line (LINE) app_stream
# registrations (http.method, http.request_line, http.raw_uri,
# http.protocol, toserver). The request line is split over two TCP segments,
# so on the first segment the HTP progress is at request_line while the line
# buffers are still empty (no partial request-line inspection). Each engine's
# no-match there is provisional and must not be converted to CANT_MATCH;
# flow A (49170-49173) completes the line into "GET /index HTTP/1.1" and is
# accepted, each B flow (49174-49177) matches no keyword and is dropped once
# by the engines' own eof CANT_MATCH.
#
# Expected: exactly 4 `firewall default app policy` drops (B1-B4).
#
# accept:hook tcp:all $HOME_NET any <> $EXTERNAL_NET any (flow:not_established; sid:1021;)
# accept:hook tcp:all $HOME_NET any <> $EXTERNAL_NET any (flow:established; sid:1022;)

# allow session setup
accept:hook tcp:all $HOME_NET any <> $EXTERNAL_NET any (flow:not_established; sid:1021;)
accept:hook tcp:all $HOME_NET any <> $EXTERNAL_NET any (flow:established; sid:1022;)

accept:flow,alert http1:<request_line $HOME_NET any -> $EXTERNAL_NET any (http.method; content:"GET"; sid:211;)
accept:flow,alert http1:<request_line $HOME_NET any -> $EXTERNAL_NET any (http.request_line; content:"GET /"; sid:212;)
accept:flow,alert http1:<request_line $HOME_NET any -> $EXTERNAL_NET any (content:"/index"; http_raw_uri; sid:213;)
accept:flow,alert http1:<request_line $HOME_NET any -> $EXTERNAL_NET any (http.protocol; content:"HTTP/1.1"; sid:214;)
