# LTE (<hook) state matrix: smtp ts request_data / multi-three-active
# Three active keyword rules at S: the coverage accounting keeps the two failing siblings from applying the state default before the matching rule accepts.
#
# The packet:filter default policy accepts the session (see suricata.yaml).
# The last rule is scaffolding: it covers the opposite direction so its
# default policy does not drop the flow before this direction reaches S + 1.

accept:hook smtp:<response_complete $EXTERNAL_NET any -> $HOME_NET any (sid:9001;)

accept:flow,alert smtp:<request_data $HOME_NET any -> $EXTERNAL_NET any (email.from; content:"nope@example.com"; sid:100;)
accept:flow,alert smtp:<request_data $HOME_NET any -> $EXTERNAL_NET any (email.from; content:"nope@example.com"; sid:101;)
accept:flow,alert smtp:<request_data $HOME_NET any -> $EXTERNAL_NET any (email.from; content:"alice@example.com"; sid:102;)
