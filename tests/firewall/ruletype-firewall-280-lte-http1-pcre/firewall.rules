# LTE (<hook) pcre coverage: http1 ts request_headers / pcre predicate
# Same geometry as the single-content-match cell, but the predicate is a
# pcre on the http.host buffer instead of a content match.
#
# The packet:filter default policy accepts the session (see suricata.yaml).
# The last rule is scaffolding: it covers the opposite direction so its
# default policy does not drop the flow before this direction reaches S + 1.

accept:hook http1:<response_complete $EXTERNAL_NET any -> $HOME_NET any (sid:9001;)

accept:flow,alert http1:<request_headers $HOME_NET any -> $EXTERNAL_NET any (http.host; pcre:"/example\.com/R"; sid:100;)
