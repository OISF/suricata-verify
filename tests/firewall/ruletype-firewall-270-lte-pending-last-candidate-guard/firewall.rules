# A pending higher-hook LTE rule (buffer still incomplete, so its verdict is
# not final) with a failing keyword rule last by sid at a lower hook. The
# failing sibling must not decide the higher hook while the LTE rule is
# unresolved: the default policy can only land once the buffer completes and
# the LTE rule resolves as no match.
accept:hook http1:<response_complete $EXTERNAL_NET any -> $HOME_NET any (sid:9001;)

accept:flow,alert http1:<request_headers $HOME_NET any -> $EXTERNAL_NET any (http.host; content:"nope.example"; sid:100;)
accept:flow,alert http1:<request_line $HOME_NET any -> $EXTERNAL_NET any (http.uri; content:"/zzz"; sid:200;)
