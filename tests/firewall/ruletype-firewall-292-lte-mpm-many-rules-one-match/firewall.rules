# A ruleset shaped like a host ruleset: many < hook rules at one state, one of
# which matches. The MPM selects the matching rule; the others stay pending for
# the policy walk but must not decide the state.

accept:hook http1:<response_complete $EXTERNAL_NET any -> $HOME_NET any (sid:9001;)

accept:flow,alert http1:<request_headers $HOME_NET any -> $EXTERNAL_NET any (http.host; content:"host1.example"; sid:100;)
accept:flow,alert http1:<request_headers $HOME_NET any -> $EXTERNAL_NET any (http.host; content:"host2.example"; sid:101;)
accept:flow,alert http1:<request_headers $HOME_NET any -> $EXTERNAL_NET any (http.host; content:"www.example.com"; sid:102;)
accept:flow,alert http1:<request_headers $HOME_NET any -> $EXTERNAL_NET any (http.host; content:"host4.example"; sid:103;)
accept:flow,alert http1:<request_headers $HOME_NET any -> $EXTERNAL_NET any (http.host; content:"host5.example"; sid:104;)
