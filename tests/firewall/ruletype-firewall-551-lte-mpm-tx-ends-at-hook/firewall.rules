# The rule is hooked at the state the transaction never leaves, and its pattern is
# absent: it stays pending, so the state has to be decided by the default policy.
accept:hook tcp:all any any -> any any (flow:not_established; sid:1;)
accept:hook tcp:all any any <> any any (flow:established; sid:2;)

accept:flow,alert http1:<request_headers $HOME_NET any -> $EXTERNAL_NET any (http.host; content:"nope.example.com"; sid:100;)
