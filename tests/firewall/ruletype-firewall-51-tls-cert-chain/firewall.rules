# allow session setup
accept:hook tcp:all $HOME_NET any <> $EXTERNAL_NET any (flow:not_established; sid:1021;)
accept:hook tcp:all $HOME_NET any <> $EXTERNAL_NET 443 (flow:established; sid:1022;)

accept:hook tls:client_started $HOME_NET any -> $EXTERNAL_NET any (sid:101;)
drop:flow tls:client_hello $HOME_NET any -> $EXTERNAL_NET any (tls.version:1.0; msg:"TLS 1.0 not allowed"; sid:102;)
accept:hook tls:client_hello $HOME_NET any -> $EXTERNAL_NET any (tls.sni; content:"www.google.com"; sid:103;)
accept:hook tls:client_cert $HOME_NET any -> $EXTERNAL_NET any (sid:104;)
accept:hook tls:client_data $HOME_NET any -> $EXTERNAL_NET any (sid:105;)
accept:hook tls:client_finished $HOME_NET any -> $EXTERNAL_NET any (sid:106;)

accept:hook tls:server_started $EXTERNAL_NET any -> $HOME_NET any (sid:107;)
accept:hook tls:server_hello $EXTERNAL_NET any -> $HOME_NET any (sid:108;)
drop:flow tls:server_data $EXTERNAL_NET any -> $HOME_NET any (tls.version:1.0; msg:"TLS 1.0 not allowed"; sid:109;)
accept:hook tls:server_data $EXTERNAL_NET any -> $HOME_NET any (sid:110;)
accept:flow tls:server_cert $EXTERNAL_NET any -> $HOME_NET any (tls.cert_chain_len:>2; sid:111; msg:"TLS certs chain length check"; alert;)
# other hooks skipped


# Implicit drop all else
# the ServerHello record walks over to server_cert before the chain is
# parsed; the chain check (111) decides on the certificate record itself.
accept:hook tls:server_cert $EXTERNAL_NET any -> $HOME_NET any (sid:112; msg:"server_cert hand-over";)
