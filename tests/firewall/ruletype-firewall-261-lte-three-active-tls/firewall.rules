# More than two active LTE (<hook) rules in one direction (tls toserver).
#
# Three LTE rules are pending at the same hook: two with a non-matching
# tls.version and one that matches. The two failures must not apply the
# default policy for the hook while the rules count each other as pending
# coverage; the third matches and accepts the flow.
#
# The opposite direction gets one scaffolding accept:hook <last-state rule so
# its default policy does not drop the flow first.
accept:hook tls:<server_finished $EXTERNAL_NET any -> $HOME_NET any (sid:9001;)

accept:flow,alert tls:<client_cert $HOME_NET any -> $EXTERNAL_NET any (tls.version:1.3; sid:100;)
accept:flow,alert tls:<client_cert $HOME_NET any -> $EXTERNAL_NET any (tls.version:1.1; sid:101;)
accept:flow,alert tls:<client_cert $HOME_NET any -> $EXTERNAL_NET any (tls.version:1.2; sid:102;)
