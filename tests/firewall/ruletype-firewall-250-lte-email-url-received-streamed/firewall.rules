# SMTP sessions with streaming MIME (progress request_data). The Received
# header and the body URL arrive in the second MIME packet: on the first
# DATA pass the email.url and email.received multi-buffers are empty - their
# no-matches there are PROVISIONAL (the multi-buffers are streaming) and
# must not be converted to CANT_MATCH.
#
# * flow A (49290): Received header and body URL "urlA.example.com"; both
#   keywords match on the second pass; the flow is accepted.
# * flow B (49291): no Received header and no URL; no keyword matches; the
#   flow is dropped once when the mail completes (the multi-buffer engines'
#   own eof CANT_MATCH).
#
# Expected: exactly 1 `firewall default app policy` drop (flow B).
#
# accept:hook tcp:all $HOME_NET any <> $EXTERNAL_NET any (flow:not_established; sid:1021;)
# accept:hook tcp:all $HOME_NET any <> $EXTERNAL_NET any (flow:established; sid:1022;)

# allow session setup
accept:hook tcp:all $HOME_NET any <> $EXTERNAL_NET any (flow:not_established; sid:1021;)
accept:hook tcp:all $HOME_NET any <> $EXTERNAL_NET any (flow:established; sid:1022;)

# keep the flow alive while the SMTP session is set up (before DATA): the
# first tx pass happens at request_started, where none of the email buffers
# (and thus no LTE rule) can match yet; without a covering rule the default
# app policy would drop the flow before the MIME is ever parsed. The shield
# is state-scoped (hook) and does not mask the request_data/request_complete
# adjudication.
accept:hook,alert smtp:request_started $HOME_NET any -> $EXTERNAL_NET any (sid:701;)
accept:hook,alert smtp:response_started $EXTERNAL_NET any -> $HOME_NET any (sid:702;)
accept:hook,alert smtp:response_data $EXTERNAL_NET any -> $HOME_NET any (sid:703;)

accept:flow,alert smtp:<request_data $HOME_NET any -> $EXTERNAL_NET any (email.url; content:"urlA.example.com"; sid:211;)
accept:flow,alert smtp:<request_data $HOME_NET any -> $EXTERNAL_NET any (email.received; content:"a.example.com"; sid:212;)
