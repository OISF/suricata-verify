# Allow TCP session setup.
accept:hook tcp:all $HOME_NET any <> $EXTERNAL_NET any (flow:not_established; sid:1021;)
accept:hook tcp:all $HOME_NET any <> $EXTERNAL_NET any (flow:established; sid:1022;)

# This matching rule precedes the inapplicable LTE rule at the same hook.
accept:flow,alert tls:client_hello_done $HOME_NET any -> $EXTERNAL_NET any (tls.sni; content:"www.google.com"; sid:2300001;)

# The PCAP source is 10.16.1.11, so this rule must not cover client_in_progress.
accept:flow,alert tls:<client_hello_done 192.0.2.0/24 any -> $EXTERNAL_NET any (tls.sni; content:"www.google.com"; sid:2300002;)
