# # Two POST flows with Content-Length 34 whose body arrives in two TCP
# # segments (20 x "A" then 14 bytes):
#
# * flow A (port 49157): second segment "secondBBBBBBBB" (keyword present);
# * flow B (port 49158): second segment "nomatchBBBBBBBB" (keyword absent).
#
# The request_body buffer can still grow while the progress is at
# request_body (BODY), so the provisional no match of the first segment must
# not be converted to CANT_MATCH (http.request_body is a streaming buffer).
#
# * flow A: the keyword matches in the second body segment and the accept:flow
#   accepts the flow.
# * flow B: the completed body never matches; the engine's own eof CANT_MATCH
#   at the progress after BODY kills the rule and the flow drops by the
#   default app policy.
#
# Expected: exactly 1 `firewall default app policy` drop (flow B).
#
# accept:hook tcp:all $HOME_NET any <> $EXTERNAL_NET any (flow:not_established; sid:1021;)
# accept:hook tcp:all $HOME_NET any <> $EXTERNAL_NET any (flow:established; sid:1022;)

# allow session setup
accept:hook tcp:all $HOME_NET any <> $EXTERNAL_NET any (flow:not_established; sid:1021;)
accept:hook tcp:all $HOME_NET any <> $EXTERNAL_NET any (flow:established; sid:1022;)

accept:flow,alert http1:<request_body $HOME_NET any -> $EXTERNAL_NET any (http.request_body; content:"second"; sid:211;)
