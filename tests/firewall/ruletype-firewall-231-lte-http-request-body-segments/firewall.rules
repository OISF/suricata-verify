# Allow TCP session setup while leaving app-layer hooks at their default drop.
accept:hook tcp:all any any <> any any (flow:not_established; sid:1021;)
accept:hook tcp:all any any <> any any (flow:established; sid:1022;)

# The first content arrives in one body update and the second in the next.
accept:flow,alert http1:<request_body any any -> any any (http.request_body; content:"first-body-"; fast_pattern; content:"second-body"; sid:2310001;)
