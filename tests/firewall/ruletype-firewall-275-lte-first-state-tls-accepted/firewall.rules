# LTE (<) rule at the protocol's first state (progress 0): accepted.
#
# tls:<client_started is the auto-accept (<hook) form at the protocol's first
# to-server state. There are no prior states to cover, so it is exactly
# equivalent to the plain hook form.
#
# The packet:filter default policy accepts the session (see suricata.yaml).
# The last rule is scaffolding: it covers the opposite direction so its
# default policy does not drop the flow.

accept:hook tls:<server_finished $EXTERNAL_NET any -> $HOME_NET any (sid:9001;)

accept:flow,alert tls:<client_started $HOME_NET any -> $EXTERNAL_NET any (sid:100;)
