# LTE (<hook) state matrix: smtp ts request_data / multi-out-of-scope-sibling
# A matching rule at S and an out of scope sibling last by sid: the trailing candidate must not disturb the accept and must not add pending coverage.
#
# The packet:filter default policy accepts the session (see suricata.yaml).
# The last rule is scaffolding: it covers the opposite direction so its
# default policy does not drop the flow before this direction reaches S + 1.

accept:hook smtp:<response_complete $EXTERNAL_NET any -> $HOME_NET any (sid:9001;)

accept:flow,alert smtp:<request_data $HOME_NET any -> $EXTERNAL_NET any (email.from; content:"alice@example.com"; sid:100;)
accept:flow,alert smtp:<request_data 198.51.100.0/24 any -> 198.51.100.0/24 any (sid:9100;)
