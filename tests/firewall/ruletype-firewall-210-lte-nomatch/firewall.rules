# allow session setup
accept:hook tcp:all $HOME_NET any <> $EXTERNAL_NET any (flow:not_established; sid:1021;)
accept:hook tcp:all $HOME_NET any <> $EXTERNAL_NET any (flow:established; sid:1022;)
# Drop rule at client_hello_done that is a *candidate* (the primary SNI content
# "www.google.com" matches the pcap SNI, so the SNI prefilter selects it) but does NOT
# fully match (the second content "zzznotthere" is absent). It is the last firewall rule
# for the client_hello_done state, so its no-match must trigger the per-state default
# policy -- unless a later auto-accept-prior-states (<) rule covers that state.
drop:flow tls:client_hello_done $HOME_NET any -> $EXTERNAL_NET any (tls.sni; content:"www.google.com"; nocase; content:"zzznotthere"; sid:210;)
# Auto-accept-prior-states at a higher hook: covers client_hello_done (and the head gap).
accept:flow tls:<client_handshake_done $HOME_NET any -> $EXTERNAL_NET any (alert; sid:211;)
