# BUG REPRO (pending-phase coverage from an out-of-scope LTE rule -> false accept).
#
# Two rules at client_hello (hook 1). The first one (sid 210) matches the flow
# (SNI www.google.com). The second one (sid 211) is a <hook (auto-accept-prior-states)
# rule scoped to an address range the flow does NOT use (198.51.100.0/24; the flow is
# 10.16.1.11 -> 24.244.4.23), so its header/packet predicates do not match and it can
# never be the rule deciding this flow.
#
# Because sid 211 never matches, it provides NO pending-phase coverage for the prior
# state client_started. The default app policy (drop) must therefore be applied
# to client_started.
#
# Buggy behaviour: the in-progress LTE candidate list scan counts sid 211 before its
# header/packet predicates are checked. Its hook (client_hello) then suppresses
# the head-gap default drop for client_started, and the matching sid 210
# accept:flow accepts the flow before the inapplicable LTE rule is even inspected:
# 0 default-app-policy drops -> per-state false accept.
#
# Correct behaviour: 1 to_server "firewall default app policy" drop
# (client_started is not covered by any applicable pending < rule).
#
# Pcap SNI is www.google.com, unfragmented ClientHello.

# allow session setup
accept:hook tcp:all $HOME_NET any <> $EXTERNAL_NET any (flow:not_established; sid:1021;)
accept:hook tcp:all $HOME_NET any <> $EXTERNAL_NET any (flow:established; sid:1022;)

# head rule: matching address + keyword, at client_hello
accept:flow,alert tls:client_hello $HOME_NET any -> $EXTERNAL_NET any (tls.sni; content:"www.google.com"; sid:210;)

# auto-accept-prior-states rule at the SAME hook, but scoped to an address range the
# flow does not use: it must NOT count as pending coverage for client_started
accept:flow,alert tls:<client_hello 198.51.100.0/24 any -> 198.51.100.0/24 any (sid:211;)
