# BUG REPRO (provisional body no-match converted to CANT_MATCH -> premature drop).
#
# The request body is split over two TCP segments (see generate-pcap.py). The
# http.request_body content keyword ("second") only appears in the SECOND body
# segment. On the first body segment the body inspection sees no match yet, but
# the body can still grow: this is a PROVISIONAL no-match at the rule's own hook
# state (request_body), not a definitive one.
#
# Buggy behaviour: the no match for the in-progress < rule is converted to
# CANT_MATCH at the rule's own hook state. As this is the last firewall rule for
# request_body, the no-match triggers the default app policy and the flow is
# dropped BEFORE the second body segment (with the matching content) arrives.
#
# Correct behaviour: the provisional result is kept until the body completes;
# when the second segment arrives the keyword matches and the accept:flow
# accepts the flow: 0 default-app-policy drops.

# allow session setup
accept:hook tcp:all $HOME_NET any <> $EXTERNAL_NET any (flow:not_established; sid:1021;)
accept:hook tcp:all $HOME_NET any <> $EXTERNAL_NET any (flow:established; sid:1022;)

# auto-accept-prior-states rule at the body state; the keyword only matches once
# the second body segment has been received
accept:flow,alert http1:<request_body $HOME_NET any -> $EXTERNAL_NET any (http.request_body; content:"second"; sid:211;)
