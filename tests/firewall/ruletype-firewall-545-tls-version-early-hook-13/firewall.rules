# The ClientHello is a TLS 1.3 hello fragmented across two TLS records: the
# first record only shows the record layer version 0x0303 (legacy TLS 1.2),
# the second completes the supported_versions extension (0x0304). The
# client_started hook sits before the hello decoded, so tls.version must not
# treat the legacy 1.2 miss as final: it is evaluated on every tx update and
# matches once the negotiated version decoded, on the packet completing
# supported_versions.
accept:hook,alert tls:client_started $HOME_NET any -> $EXTERNAL_NET any (tls.version:1.3; sid:100; msg:"negotiated version decoded";)
# the hello never negotiates 1.2, so this must not fire
accept:hook,alert tls:client_started $HOME_NET any -> $EXTERNAL_NET any (tls.version:1.2; sid:101;)
accept:hook tls:server_finished $EXTERNAL_NET any -> $HOME_NET any (sid:9001;)
