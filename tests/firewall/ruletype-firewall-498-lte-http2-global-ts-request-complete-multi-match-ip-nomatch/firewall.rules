# LTE (<hook) state matrix: http2:global ts request_complete / multi-match-ip-nomatch
# An out of scope rule and a matching bare rule at S: the out of scope rule must not disturb the match.
#
# The packet:filter default policy accepts the session (see suricata.yaml).
# The last rules are scaffolding: they cover the directions and the
# untested http2 tx type so their default policies do not drop the flow
# before the tested state is reached.

accept:hook http2:global:<response_complete any any <> any any (sid:9001;)
accept:hook http2:stream:<request_complete any any -> any any (sid:9002;)
accept:hook http2:stream:<response_complete any any -> any any (sid:9003;)

accept:flow,alert http2:global:<request_complete 198.51.100.0/24 any -> 198.51.100.0/24 any (sid:100;)
accept:flow,alert http2:global:<request_complete any any -> any any (sid:101;)
