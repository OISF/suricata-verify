# Accept the TCP handshake and keep established flows alive at the
# packet level.
accept:hook tcp:all any any -> any any (flow:not_established; sid:1000;)
accept:hook tcp:all any any <> any any (flow:established; sid:1001;)

# Accept all server responses.
accept:hook smtp:response_started any any -> any any (sid:1002;)
accept:hook smtp:response_data any any -> any any (sid:1003;)
accept:hook smtp:response_complete any any -> any any (sid:1004;)

# Only allow DATA txs whose attachment contains the PDF magic.
# The filedata engine is at request_data progress; once the tx has
# moved past it, the engine must report a final no match so the
# fail-closed default policy is applied.
accept:tx,alert smtp:<request_data any any -> any any (file_data; content:"%PDF"; sid:300;)
