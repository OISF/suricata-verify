# The ClientHello is split across two TLS records: the first record
# carries the handshake header and part of the message. The phase
# transition must wait until the message is fully buffered (the final
# fragment), so the client_hello decision is made only when the SNI
# is available and the sni rule can match.
accept:hook tls:client_started $HOME_NET any -> $HOME_NET any (alert; sid:1511; msg:"client_started state evaluated";)
accept:flow tls:client_hello $HOME_NET any -> $HOME_NET any (tls.sni; content:"example.com"; alert; sid:1512; msg:"sni available at client_hello";)
