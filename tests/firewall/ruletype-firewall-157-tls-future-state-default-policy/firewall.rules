# session setup
accept:hook tcp:all $HOME_NET any <> $EXTERNAL_NET any (flow:not_established; sid:1021;)
accept:hook tcp:all $HOME_NET any <> $EXTERNAL_NET any (flow:established; sid:1022;)

# The TLS rule never matches: on the ClientHello packet it is the last
# rule of the direction and it does not match, so the default
# app policy of the hello state (accept:hook, weak) triggers the
# sweep of the states walked over. That sweep must stop at the
# packet's progress (client_cert): client_data carries drop:flow in
# the config and is a future state on this packet.
accept:hook tls:client_hello any any -> any any (tls.sni; content:"blocked.example.org"; sid:11;)
