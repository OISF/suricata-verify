# LTE (<hook) state matrix: tls ts client_hello / multi-three-active
# Three active keyword rules at S: the coverage accounting keeps the two failing siblings from applying the state default before the matching rule accepts.
#
# The packet:filter default policy accepts the session (see suricata.yaml).
# The last rule is scaffolding: it covers the opposite direction so its
# default policy does not drop the flow before this direction reaches S + 1.

accept:hook tls:<server_finished $EXTERNAL_NET any -> $HOME_NET any (sid:9001;)

accept:flow,alert tls:<client_hello $HOME_NET any -> $EXTERNAL_NET any (tls.version:1.3; sid:100;)
accept:flow,alert tls:<client_hello $HOME_NET any -> $EXTERNAL_NET any (tls.version:1.3; sid:101;)
accept:flow,alert tls:<client_hello $HOME_NET any -> $EXTERNAL_NET any (tls.version:1.2; sid:102;)
