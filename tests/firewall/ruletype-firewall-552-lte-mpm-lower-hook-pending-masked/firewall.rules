accept:hook tcp:all any any -> any any (flow:not_established; sid:1;)
accept:hook tcp:all any any <> any any (flow:established; sid:2;)
accept:flow,alert http1:<request_headers $HOME_NET any -> $EXTERNAL_NET any (http.host; content:"www.example.com"; sid:110;)
accept:flow,alert http1:<request_line $HOME_NET any -> $EXTERNAL_NET any (http.uri; content:"/absent.token"; sid:113;)
