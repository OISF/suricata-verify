# Mixed-protocol LTE (<hook) ruleset on a TLS flow. All rules share one
# firewall ruleset: the TLS rules must be the only ones that can decide the
# TLS transaction, and the foreign-protocol LTE rules (http1, smtp, http2)
# must be invisible to it.
#
# The foreign rules carry the same numeric hook as a TLS state and raw
# content bytes that are present in the ClientHello (the SNI
# "www.google.com"), so a protocol-blind MPM would select them. They must
# add no alert, no drop and no pending hook coverage.
#
# TLS rule sequence:
# - sid:100 matches the SNI at client_hello (hook 1) and accepts the hook
#   (accept:hook, not accept:flow, so the later state default can still fire);
# - sid:101 at client_cert (hook 2) fails its tls.version keyword, so the
#   TLS client_cert per-state default policy (drop:flow,alert) drops the flow.
#
# The opposite direction carries one scaffolding accept:hook <last-state rule
# so its default policy does not drop the flow before toserver reaches the
# client_cert default.
accept:hook tls:<server_finished $EXTERNAL_NET any -> $HOME_NET any (sid:9001;)

# TLS: matching accept at client_hello (SNI from the fixture)
accept:hook,alert tls:<client_hello $HOME_NET any -> $EXTERNAL_NET any (tls.sni; content:"www.google.com"; sid:100;)

# TLS: failing rule at a later state; its per-state default must still fire
accept:flow,alert tls:<client_cert $HOME_NET any -> $EXTERNAL_NET any (tls.version:1.3; sid:101;)

# Foreign http1 LTE rules: hook 1 (client_hello) with raw ClientHello bytes,
# and hook 2 (client_cert) out of scope.
accept:flow,alert http1:<request_line $HOME_NET any -> $EXTERNAL_NET any (http.uri; content:"google"; sid:200;)
accept:flow,alert http1:<request_headers 198.51.100.0/24 any -> 198.51.100.0/24 any (http.host; content:"www.google.com"; sid:201;)

# Foreign smtp LTE rule: hook 1 (client_hello)
accept:flow,alert smtp:request_data $HOME_NET any -> $EXTERNAL_NET any (content:"www.google.com"; sid:202;)

# Foreign http2 stream LTE rule: hook 1 (client_hello)
accept:flow,alert http2:stream:<request_headers any any -> any any (http.host; content:"www.google.com"; sid:203;)
