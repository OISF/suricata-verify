# Packet-scope TD drop on the very packet the pre_stream rule bypasses.
drop:packet tcp any any -> any any (msg:"TD packet drop on the bypassed SYN"; flow:to_server; tcp.flags:S; sid:100003;)

# Would alert on the response body if the flow were still inspected.
alert http any any -> any any (msg:"Response body inspected after bypass"; flow:to_client,established; http.response_body; content:"uid=0|28|root|29|"; sid:100001;)
