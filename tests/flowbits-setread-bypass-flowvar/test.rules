# sid:1 sets flowvar fv, sid:2 reads it. Both are flowbits SET_READ, on
# unrelated bits, so there is no flowbit dependency between them.
alert tcp any any -> any any (flowbits:isset,a1; flowbits:set,a2; pcre:"/(?P<flow_fv>[a-z]+)/"; sid:1;)
alert tcp any any -> any any (flowbits:isset,b1; flowbits:set,b2; flowvar:fv,"abc"; sid:2;)
# Control: the same flowvar dependency, listed in the same order, without
# flowbits. SCSigOrderByFlowvarCompare keeps the setter ahead of the reader.
alert tcp any any -> any any (pcre:"/(?P<flow_fv>[a-z]+)/"; sid:3;)
alert tcp any any -> any any (flowvar:fv,"abc"; sid:4;)
