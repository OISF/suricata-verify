# Rule forces the header buffers to be rebuilt for inspection.
alert http any any -> any any (msg:"HTTP header buffer inspected"; flow:to_server,established; http.header; content:"x-e2e-mark"; sid:1000001; rev:1;)
# The 34483 indexed references to the 65503-byte dynamic table entry must not be copied
# into the inspection buffers and the buffers need to hold the entry once
alert http any any -> any any (msg:"http.header bounded"; flow:to_server,established; http.header; bsize:65551; sid:1000002; rev:1;)
alert http any any -> any any (msg:"http.header.raw bounded"; flow:to_server,established; http.header.raw; bsize:65551; sid:1000003; rev:1;)
alert http any any -> any any (msg:"http.header_names bounded"; flow:to_server,established; http.header_names; bsize:34; sid:1000004; rev:1;)
# Stock rule from rules/http2-events.rules
alert http2 any any -> any any (msg:"SURICATA HTTP2 too long repeated headers"; flow:established; app-layer-event:http2.too_long_repeated_headers; classtype:protocol-command-decode; sid:2290023; rev:1;)
