alert dns any any -> any any (msg:"TEST hashlib sha256 update-after-finalize"; \
      flow:to_server; \
      dns.queries.rrname; content: "www.suricata-ids.org"; \
      lua:sha256-update-after-finalize.lua; sid:1; rev:1;)
