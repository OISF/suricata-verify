# trailer block cut by depth: what htp parsed must still reach the trailer buffers
alert http any any -> any any (msg:"trl cut raw"; flow:to_server; http.trailer.raw; content:"X-TrailerField|3a 20|dt1"; sid:10; rev:1;)
alert http any any -> any any (msg:"trl cut field"; flow:to_server; http.trailer; content:"X-TF2|3a 20|dt2"; sid:11; rev:1;)
# control: trailer block ended properly
alert http any any -> any any (msg:"ctl trl"; flow:to_server; http.trailer; content:"X-TF2|3a 20|ok2"; sid:20; rev:1;)
alert http any any -> any any (msg:"ctl hdr"; flow:to_server; http.header; content:"X-Marker|3a 20|yes"; sid:21; rev:1;)
