alert tcp any any -> any any (msg:"relative pcre with no preceding match"; \
    pcre:"/^TARGET/R"; sid:1; rev:1;)
alert tcp any any -> any any (msg:"relative pcre after byte_test"; byte_test:4,=,8,0; \
    pcre:"/^TARGET/R"; sid:2; rev:1;)
alert tcp any any -> any any (msg:"relative pcre after isdataat"; isdataat:10; \
    pcre:"/^TARGET/R"; sid:3; rev:1;)
